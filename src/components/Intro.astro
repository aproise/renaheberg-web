---
interface Props {
  t: {
    title: string;
    text: string;
    factsHeading: string;
    period: string;
    facts: { value: string; label: string }[];
    status: string;
    hero?: { rna: string };
  };
}
const { t } = Astro.props;
const rnaNumber = t.hero?.rna || 'W212012750';
const rnaUrl = `https://assoce.fr/waldec/${rnaNumber}/RENAHEBERG`;
// Replace "RNA W212012750" in status with a link
const statusHtml = t.status.replace(/\n/g, '<br>').replace(
  `RNA ${rnaNumber}`,
  `<a href="${rnaUrl}" target="_blank" rel="noreferrer">RNA ${rnaNumber}</a>`
);
---
<section class="intro grid gap-18 lg:grid-cols-[1.1fr_0.9fr] items-center py-28 border-b border-[var(--line)]" id="page-content">
  <div class="intro__copy">
    <h2 class="text-[clamp(2.2rem,5vw,4rem)] leading-[1.04] tracking-[-0.06em]">{t.title}</h2>
    <p class="text-[var(--muted)]">{t.text}</p>
  </div>
  <div class="facts">
    <div class="facts__heading">
      <strong>{t.factsHeading}</strong>
      <span>{t.period}</span>
    </div>
    <div class="facts__grid">
      {t.facts.map((fact) => (
        <div>
          <b>{fact.value}</b>
          <span>{fact.label}</span>
        </div>
      ))}
    </div>
    <p class="facts__status" set:html={statusHtml} />
  </div>
</section>