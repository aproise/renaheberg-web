---
interface Props {
  t: {
    eyebrow: string;
    brand: string;
    rna: string;
    claim: string;
    scrollCta: string;
    scrollAria: string;
  };
}
const { t } = Astro.props;
---
<section class="hero min-h-screen grid place-items-center border-b border-[var(--line)] px-4 py-12 text-center" aria-labelledby="hero-title">
  <div class="hero__inner flex flex-col items-center">
    <p class="eyebrow">{t.eyebrow}</p>
    <button
      class="brand"
      id="hero-title"
      type="button"
      aria-label={t.scrollAria}
    >
      <span class="brand__name">{t.brand}</span>
      <span class="brand__rna" aria-hidden="true">{t.rna}</span>
    </button>
    <p class="hero__claim">{t.claim}</p>
    <button
      class="scroll-cta"
      type="button"
      data-scroll-to="page-content"
    >
      <span>{t.scrollCta}</span>
      <svg class="scroll-cta__arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <path d="M12 4v15M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</section>

<script type="module" src="../scripts/hero-scroll.js"></script>