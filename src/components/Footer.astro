---
interface Props {
  t: {
    copyright: string;
    author: string;
  };
}
const { t } = Astro.props;
---
<footer>
  <div class="container-custom footer__inner border-t border-[var(--line)]">
    <span>{t.copyright}</span>
    <span set:html={t.author.replace('{link}', '<a href="https://git.renaheberg.fr" target="_blank" rel="noreferrer">Aproise</a>')} />
  </div>
</footer>