---
const { locale, translations } = Astro.props;
const otherLocale = locale === 'fr' ? 'en' : 'fr';
const otherLabel = locale === 'fr' ? 'EN' : 'FR';
const ariaLabel = locale === 'fr' ? translations.ui.langSwitchToEn : translations.ui.langSwitchToFr;
---
<button
  id="lang-toggle"
  class="fixed bottom-16 right-4 z-50 btn-icon rounded-lg bg-[var(--paper)] border border-[var(--line)] text-[var(--ink)] font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[var(--ink)] dark:focus:ring-[var(--ink-dark)] shadow-md hover:shadow-lg active:scale-[0.95]"
  aria-label={ariaLabel}
  title={ariaLabel}
  data-lang={otherLocale}
>
  {otherLabel}
</button>

<script type="module">
  import '../scripts/lang-switcher.js';
</script>