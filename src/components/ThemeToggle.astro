---
interface Props {
  t: {
    theme: string;
    themeLight: string;
    themeDark: string;
  };
}
const { t } = Astro.props;
---
<button
  id="theme-toggle"
  class="fixed bottom-4 right-4 z-50 btn-icon rounded-lg bg-[var(--paper)] border border-[var(--line)] transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[var(--ink)] dark:focus:ring-[var(--ink-dark)] shadow-md hover:shadow-lg active:scale-[0.95]"
  aria-label={t.themeDark}
  title={t.themeDark}
  data-theme="light"
  data-theme-light-title={t.themeLight}
  data-theme-dark-title={t.themeDark}
>
  <svg class="w-5 h-5 text-[var(--ink)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script type="module">
  import '../scripts/theme-toggle.js';
</script>