---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../utils/i18n';

const locale = 'en' as const;
const t = getTranslations(locale);
const e404 = t.error404;
---
<Layout
  locale={locale}
  title={e404.title}
  description={e404.subtitle}
  translations={t}
>
  <main class="min-h-screen flex flex-col items-center justify-center px-4 py-20">
    <div class="text-center max-w-md">
      <div class="mb-8">
        <svg class="mx-auto w-24 h-24 text-[var(--muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h1 class="text-[clamp(2.5rem,6vw,4rem)] font-bold text-[var(--ink)] mb-4">{t.error404.title}</h1>
      <p class="text-[var(--muted)] text-lg mb-10">{t.error404.subtitle}</p>
      <a
        href={`/${locale}`}
        class="btn-primary inline-flex items-center gap-2 px-6 py-3 text-base"
        aria-label={t.error404.backHomeAria}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        {t.error404.backHome}
      </a>
    </div>
  </main>
</Layout>