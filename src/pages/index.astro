---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../utils/i18n';

const t = getTranslations('fr');
---
<Layout
  locale="fr"
  title={t.meta.title}
  description={t.meta.description}
  translations={t}
>
  <script type="module">
    import '../scripts/locale-redirect.js';
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0;url=/fr" />
    <p>Redirection... <a href="/fr">Français</a> | <a href="/en">English</a></p>
  </noscript>
</Layout>